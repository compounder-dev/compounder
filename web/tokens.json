  "colorRules": {
    "depth": "Fill only. page, then raised, then surface. No border and no shadow on cards.",
    "borders": "stroke.hairline separates rows inside a card. stroke.control outlines inputs, checkboxes and switches.",
    "action": "One action colour. A screen has at most one filled action button in view.",
    "attention": "A notice that needs the user uses action.text for its icon and an action button. There is no separate warning colour.",
    "waiting": "A waiting state is neutral: ground.hover fill, text.muted, a clock icon and a word. No colour.",
    "gainLoss": "status.gain and status.loss are for money going up or down, and loss doubles as the error colour. Always with an arrow or a sign, never colour alone.",
    "blocks": "Block fills are the same in both themes and always carry block.ink text. Edges and connector lines take the Edge value of the parent block.",
    "fund": "A fund or strategy gets one of five identity colours when it is made and keeps it. Order: blue, orange, teal, violet, magenta. A sixth reuses blue. The name is always shown beside the colour.",
    "neverUse": "No raw hex in components. No second green or red. No gradients on controls."
  },
