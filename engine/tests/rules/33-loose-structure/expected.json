       },
       "right": {
        "fixed": 0
       }
      },
      "else": [
       {
        "asset": {
         "market": "equities",
         "symbol": "XLF"
        },
        "block": "asset"
       }
      ],
      "then": [
       {
        "asset": {
         "market": "equities",
         "symbol": "XLK"
        },
        "block": "asset"
       }
      ]
     }
    ]
   },
   {
    "block": "weight",
    "children": [
     {
      "asset": {
       "market": "equities",
       "symbol": "XLI"
      },
      "block": "asset"
     }
    ],
    "weighting": {
     "type": "equal"
    }
   }
  ],
  "weighting": {
   "type": "equal"
  }
 }
}
