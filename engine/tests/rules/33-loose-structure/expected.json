{
 "rebalance": {
  "frequency": "daily",
  "type": "calendar"
 },
 "root": {
  "block": "weight",
  "children": [
   {
    "block": "if",
    "condition": {
     "compare": "above",
     "left": {
      "asset": {
       "market": "equities",
       "symbol": "SPY"
      },
      "indicator": "price"
     },
     "right": {
      "fixed": 0
     }
    },
    "else": [
     {
      "block": "filter",
      "children": [
       {
        "asset": {
         "market": "equities",
         "symbol": "XLE"
        },
        "block": "asset"
       },
       {
        "asset": {
         "market": "equities",
         "symbol": "XLV"
        },
        "block": "asset"
       }
      ],
      "count": 1,
      "sort_by": {
       "indicator": "cumulative_return",
