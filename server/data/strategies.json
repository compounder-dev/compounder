  {
   "id": "fast-lane-with-a-brake",
   "name": "Fast Lane with a Brake",
   "summary": "Three times the Nasdaq 100 while its trend is up and it is not overheated, and short-term bills the rest of the time.",
   "accent": "orange",
   "rules": {
    "name": "Fast Lane with a Brake",
    "rebalance": {
     "type": "calendar",
     "frequency": "daily"
    },
    "root": {
     "block": "if",
     "condition": {
      "all": [
       {
        "compare": "above",
        "left": {
         "indicator": "price",
         "asset": {
          "market": "equities",
          "symbol": "QQQ"
