  {
   "id": "trend-switch",
   "name": "Trend Switch",
   "summary": "Holds the S&P 500 while it is above its 200-day average, and short-term bills while it is below.",
   "accent": "orange",
   "rules": {
    "name": "Trend Switch",
    "rebalance": {
     "type": "calendar",
     "frequency": "daily"
    },
    "root": {
     "block": "if",
     "condition": {
      "compare": "above",
      "left": {
       "indicator": "price",
       "asset": {
        "market": "equities",
        "symbol": "SPY"
       }
      },
      "right": {
       "indicator": "average_price",
       "asset": {
        "market": "equities",
        "symbol": "SPY"
       },
       "window": 200
      }
     },
     "then": [
      {
       "block": "asset",
       "asset": {
        "market": "equities",
        "symbol": "SPY"
       }
      }
     ],
     "else": [
      {
       "block": "asset",
       "asset": {
        "market": "equities",
        "symbol": "BIL"
       }
      }
     ]
    }
   }
  },
  {
   "id": "home-or-away",
   "name": "Home or Away",
   "summary": "Each month, holds whichever of US and overseas shares did better over the past year, or bonds when neither beat cash.",
   "accent": "magenta",
   "rules": {
    "name": "Home or Away",
    "rebalance": {
     "type": "calendar",
     "frequency": "monthly"
    },
    "root": {
     "block": "if",
     "condition": {
      "any": [
       {
        "compare": "above",
        "left": {
         "indicator": "cumulative_return",
         "asset": {
          "market": "equities",
          "symbol": "SPY"
         },
         "window": 252
        },
        "right": {
         "indicator": "cumulative_return",
         "asset": {
          "market": "equities",
          "symbol": "BIL"
         },
         "window": 252
        }
       },
       {
        "compare": "above",
        "left": {
         "indicator": "cumulative_return",
         "asset": {
          "market": "equities",
          "symbol": "EFA"
         },
         "window": 252
        },
        "right": {
         "indicator": "cumulative_return",
         "asset": {
          "market": "equities",
          "symbol": "BIL"
         },
         "window": 252
        }
       }
      ]
     },
     "then": [
      {
       "block": "filter",
       "sort_by": {
        "indicator": "cumulative_return",
        "window": 252
       },
       "take": "top",
       "count": 1,
       "children": [
        {
         "block": "asset",
         "asset": {
          "market": "equities",
          "symbol": "SPY"
         }
        },
        {
         "block": "asset",
         "asset": {
          "market": "equities",
          "symbol": "EFA"
         }
        }
       ]
      }
     ],
     "else": [
      {
       "block": "asset",
       "asset": {
        "market": "equities",
        "symbol": "AGG"
       }
      }
     ]
    }
   }
  },
